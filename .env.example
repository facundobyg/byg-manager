# ── Base de datos ──────────────────────────────────────────────────────────────
# Neon pooled URL (runtime queries — usar pgbouncer para Vercel)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon direct URL (solo para prisma db push / migrate — NO para runtime)
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth (NextAuth v5) ─────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# URL pública del deployment
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"

# ── App flags ─────────────────────────────────────────────────────────────────
# Mostrar banner "BETA PRIVADA" en la UI
NEXT_PUBLIC_BETA_MODE=true

# Activar modo solo lectura (bloquea server actions, solo para demos)
NEXT_PUBLIC_READ_ONLY_PREVIEW=false
